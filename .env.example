# Copy to .env (git-ignored) and adjust. `make secrets-local` generates random values.
# Docker Compose reads this file; services read the same variables in Kubernetes.

# --- secrets (never commit real values) ---
POSTGRES_PASSWORD=hookline
# base64 of 32 random bytes; encrypts endpoint signing secrets (AES-256-GCM)
HOOKLINE_MASTER_KEY=CHANGE_ME_base64_32_bytes
# bootstrap admin API key; must start with hk_live_
HOOKLINE_ADMIN_KEY=hk_live_CHANGE_ME_at_least_20_chars
REDIS_PASSWORD=

# --- shared (all services) ---
# debug|info|warn|error
LOG_LEVEL=info
# json|text
LOG_FORMAT=json
GRPC_ADDR=:9090
HTTP_ADDR=:8080
ADMIN_ADDR=:8081
PPROF_ENABLED=false
# wait after /readyz fails before stopping
DRAIN_DELAY=5s
SHUTDOWN_TIMEOUT=20s
# e.g. http://tempo:4317 ; empty disables export
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_RATIO=1

# --- dependencies ---
DATABASE_URL=postgres://hookline:hookline@localhost:5432/hookline?sslmode=disable
DB_MAX_CONNS=20
DB_QUERY_TIMEOUT=5s
NATS_URL=nats://localhost:4222
REDIS_ADDR=localhost:6379

# --- ingest ---
DEFAULT_INGEST_RPS=500

# --- dispatcher ---
CONTROL_GRPC_ADDR=localhost:9090
MATCH_CACHE_TTL=30s
DISPATCHER_CONCURRENCY=32

# --- worker ---
# default|demo|comma-separated durations
RETRY_SCHEDULE=demo
WORKER_CONCURRENCY=100
# hostnames that skip the private-IP check
SSRF_ALLOWLIST=chaos-customer

# --- scheduler ---
ATTEMPT_RETENTION=336h
EVENT_RETENTION=720h
OUTBOX_RETENTION=24h
IDEMPOTENCY_WINDOW=24h
AUTO_DISABLE_AFTER=72h
RECONCILE_PENDING_AFTER=10m

# --- hookctl ---
HOOKLINE_CONTROL_URL=http://localhost:8082
HOOKLINE_INGEST_URL=http://localhost:8080
CHAOS_URL=http://localhost:9000
CHAOS_INTERNAL_URL=http://chaos-customer:8080
